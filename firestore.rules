rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/bsiProfiles/$(request.auth.uid)).data;
    }

    function assignedTo(barangayId) {
      return signedIn() && profile().assignedBarangayId == barangayId;
    }

    match /bsiProfiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /places/{placeId} {
      allow read: if assignedTo(resource.data.barangayId);
      allow create: if assignedTo(request.resource.data.barangayId)
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if assignedTo(resource.data.barangayId)
        && request.resource.data.barangayId == resource.data.barangayId
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if assignedTo(resource.data.barangayId);
    }

    match /inspections/{inspectionId} {
      allow read: if assignedTo(resource.data.barangayId);
      allow create: if assignedTo(request.resource.data.barangayId)
        && request.resource.data.bsiUid == request.auth.uid;
      allow update: if assignedTo(resource.data.barangayId)
        && request.resource.data.barangayId == resource.data.barangayId
        && request.resource.data.bsiUid == request.auth.uid;
      allow delete: if false;
    }

    match /reinspections/{reinspectionId} {
      allow read: if assignedTo(resource.data.barangayId);
      allow create, update: if assignedTo(request.resource.data.barangayId)
        && request.resource.data.bsiUid == request.auth.uid;
      allow delete: if false;
    }
  }
}
